<!DOCTYPE html>
<html ng-app="ravada.app">
%= include 'bootstrap/header'
<body id="page-top" data-spy="scroll" data-target="fixed-top" role="document">
<div id="wrapper">
    %= include 'bootstrap/navigation', choose_node => 1
<div id="page-wrapper"
             ng-controller="settings_network"
             ng-init="new_network(<%= $id_node %>)"
            >
        <!--BASES AND DOMAINS LIST-->
    <div class="page-header">
        <div class="card">
        <div class="card-header">
            <h2><%=l 'New network' %></h2>
        </div>
        <div class="card-body">
%=          include '/main/network_options'
        </div>
        </div><!-- card -->
    </div> <!-- page-header -->

</div><!-- page-wrapper -->
</div><!-- wrapper -->
%= include $footer
%= include 'bootstrap/scripts'
</body>
</html>
